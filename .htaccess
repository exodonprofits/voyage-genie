# Apache config for Bluehost. Mirrors _headers (which only Cloudflare Pages reads).

# --- Force HTTPS -------------------------------------------------------------
# The X-Forwarded-Proto check prevents a redirect loop if Cloudflare's proxy
# sits in front of Bluehost.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Retired pages ------------------------------------------------------------
<IfModule mod_alias.c>
  Redirect 301 /signup.html /register.html
  Redirect 301 /packing-assistant.html /packing-checklist.html
  Redirect 301 /packing-assistant-ai.html /packing-checklist.html
  Redirect 301 /travel-budget-planner.html /trip-cost-tracker.html
  Redirect 301 /dashboard.html /trip-dashboard.html
  Redirect 301 /airportparking.html /parking-tips.html
</IfModule>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # No includeSubDomains: only add it once every subdomain has valid SSL.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content-Security-Policy is not enabled yet; see _headers for the starter policy.
  # Header always set Content-Security-Policy "default-src 'self'; ..."

  # HTML always revalidates so uploads show up immediately
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Block repo/config files from being served -------------------------------
<FilesMatch "^(\.|_headers$|_redirects$|README\.md$|CLAUDE\.md$|PHASE1-REPORT\.md$|PHASE2-PLAN\.md$|DEPLOY\.md$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 ^/workflows(/|$)
RedirectMatch 404 ^/tools(/|$)

# --- Files removed from the repo that may still sit on the server ------------
# The deploy action never deletes files it didn't upload, so these stay
# blocked here until someone removes them in File Manager.
RedirectMatch 301 "^/customs-entry-guide \(1\)\.html$" /customs-entry-guide.html
RedirectMatch 404 "^/(trade-journal-pro|add-telecom|detail|departure-location)\.html$"
RedirectMatch 404 "^/(smart-trip-finder|Voyage - Smart Trip Finder)\.json$"

Options -Indexes
